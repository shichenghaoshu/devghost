{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devghost.dev/schemas/skill-manifest.schema.json",
  "title": "SkillManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "skillId",
    "profileId",
    "target",
    "compilerName",
    "compilerVersion",
    "createdAt",
    "skillHash",
    "canonicalizationVersion",
    "tokenCount",
    "fileCount",
    "scriptsIncluded",
    "networkRequired",
    "sourceStatistics",
    "rawSourceUploaded",
    "redactionReportHash",
    "evidenceCoverage"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "skillId": { "type": "string" },
    "profileId": { "type": "string" },
    "target": { "type": "string", "enum": ["universal", "codex", "claude-code"] },
    "compilerName": { "type": "string" },
    "compilerVersion": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "skillHash": { "type": "string", "pattern": "^sha256:" },
    "canonicalizationVersion": { "const": "1" },
    "tokenCount": { "type": "integer", "minimum": 0 },
    "fileCount": { "type": "integer", "minimum": 1 },
    "scriptsIncluded": { "type": "boolean" },
    "networkRequired": { "type": "boolean" },
    "sourceStatistics": { "type": "object" },
    "rawSourceUploaded": { "type": "boolean" },
    "redactionReportHash": { "type": "string", "pattern": "^sha256:" },
    "evidenceCoverage": { "type": "object" }
  },
  "additionalProperties": false
}
