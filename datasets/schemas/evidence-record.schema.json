{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devghost.dev/schemas/evidence-record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "required": [
    "id",
    "developerProfileId",
    "evidenceType",
    "domain",
    "capability",
    "claim",
    "normalizedStatement",
    "source",
    "timestamps",
    "confidence",
    "frequency",
    "recencyWeight",
    "sensitivity",
    "containsSecret",
    "promptInjectionRisk",
    "uploadEligible",
    "conflictsWith",
    "supersedes",
    "tags",
    "rawExcerptLocalRef",
    "createdBy"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "developerProfileId": { "type": "string", "minLength": 1 },
    "evidenceType": {
      "type": "string",
      "enum": [
        "demonstrated",
        "inferred",
        "preferred",
        "aspirational",
        "negative",
        "stale",
        "conflicted",
        "unsafe"
      ]
    },
    "domain": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "normalizedStatement": { "type": "string", "minLength": 1 },
    "source": { "type": "object" },
    "timestamps": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "frequency": { "type": "integer", "minimum": 0 },
    "recencyWeight": { "type": "number", "minimum": 0, "maximum": 1 },
    "sensitivity": { "type": "string", "enum": ["public", "private", "secret"] },
    "containsSecret": { "type": "boolean" },
    "promptInjectionRisk": { "type": "string", "enum": ["none", "low", "medium", "high"] },
    "uploadEligible": { "type": "boolean" },
    "conflictsWith": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "rawExcerptLocalRef": { "type": "string", "minLength": 1 },
    "createdBy": { "type": "object" }
  },
  "additionalProperties": false
}
